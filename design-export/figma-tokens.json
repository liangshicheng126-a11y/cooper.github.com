  "effects": {
    "glass-blur": 14,
    "section-blur": 18,
    "card-shadow": "0 8px 28px rgba(15, 23, 42, 0.06)"
  },
  "components": [
    { "name": "Sidebar", "width": 320, "notes": "Fixed left, glass nav, gradient COOPER. logo" },
    { "name": "ProjectCard", "height": { "mobile": 320, "tablet": 380, "desktop": 450 }, "radius": 24 },
    { "name": "LanguageToggle", "notes": "Fixed top-right pill, glass" },
    { "name": "MasonryGallery", "notes": "Poster/photo grid with natural aspect ratios" }
  ]
}
